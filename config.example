# Per-team configuration for the VAST Builders Challenge.
#
# You do NOT need to fill this in or source it. These values are already set as
# environment variables in your VM. This file documents what exists, so you know what
# the skills are reading and what to reference in your own code.
#
# Placeholders only. Never commit real credentials.

# ---- identity ----
USERNAME=team-x
PASSWORD=<password>

# ---- S3 ----
S3_ENDPOINT=<https://s3-endpoint>
ACCESS_KEY=<access-key>
SECRET_KEY=<secret-key>
S3_CHUNKS_BUCKET=team-x-vss-chunks
S3_SEGMENTS_BUCKET=team-x-vss-chunks-segments

# ---- VastDB (database = bucket; schema + tables below) ----
# If VDB_ENDPOINT isn't set for your team, use the same value as S3_ENDPOINT.
# They are often the same host; it's named separately so the intent is clear.
VDB_ENDPOINT=<https://vastdb-endpoint>
VASTDB_BUCKET=team-x-vss-db
VDB_SCHEMA=vss-schema
VDB_COLLECTION=vss-collection
VDB_PROMPTS_COLLECTION=vss-prompts-events

# ---- DataEngine / UI ----
PIPELINE=team-x-vss
INGRESS_URL=<https://ingress-url>

# ---- Weights & Biases (agent logic / LLM inference) ----
WANDB_API_KEY=<wandb-api-key>
WANDB_TEAM=<wandb-team>
# Often the same as the team name. One project per team.
WANDB_PROJECT=<wandb-project>
